# Technetium 公共层(跨 loader 复用的 UI + Mixin)。
# 结构参考:combine/example/hello_world/common/BUILD.bazel。
# 必须用 kt_merge_library(而非 kt_jvm_library)以提供 MergeLibraryInfo,
# 供下游 merge_library_jar 合并。

load("//rule:merge_library.bzl", "kt_merge_library")

kt_merge_library(
    name = "common",
    srcs = glob([
        "src/main/kotlin/**/*.kt",
        "src/main/kotlin/**/*.java",
    ]),
    javac_opts = "//technetium:javac_opts_jvm_25",
    kotlinc_opts = "//technetium:kotlinc_opts_jvm_25",
    # 仿基岩菜单用 combine(public);Mixin 需要 mixin 框架。
    deps = [
        "//:compose",
        # Minecraft 编译期类(含 Brigadier 等 MC 内置依赖)
        "//combine/backend/minecraft/game/26.2",
        "//combine/backend/minecraft/input/26.2",
        # combine 核心 API
        "//combine/core/data",
        "//combine/core/input/interaction",
        "//combine/core/input/text",
        "//combine/core/layout",
        "//combine/core/modifier",
        "//combine/core/modifier/drawing",
        "//combine/core/modifier/focus",
        "//combine/core/modifier/placement",
        "//combine/core/modifier/scroll",
        "//combine/core/paint",
        "//combine/core/screen",
        "//combine/core/util/dispatcher",
        "//combine/core/widget/layout",
        # combine 主题
        "//combine/theme/base",
        "//combine/theme/blackstone",
        "//combine/theme/blackstone:blackstone_texture_lib",
        "//combine/theme/vanilla",
        "//combine/widget",

        # Apache Commons Lang3(消息处理)
        "@maven//:org_apache_commons_commons_lang3",
        # Kotlin Coroutines(协程支持)
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",

        # Mixin 框架(fabric 侧注入由下游 maven repo 提供)
        "@maven_fabric_26_2//:net_fabricmc_sponge_mixin",
    ],

    # Mixin 目标 touchcontroller 内部类的编译期类路径比较特殊:
    # GameActionImpl 位于 touchcontroller 内部(非 public visibility)。
    # 若编译报 visibility/找不到类,再由 CI 报错驱动修正。
    visibility = ["//technetium:__subpackages__"],
)