# Technetium — Fabric 26.2 版本层。
# 结构参考:combine/example/hello_world/versions/26.2/BUILD.bazel。
# 这是阶段 1 Fabric 验证用的构建。

load("@rules_java//java:java_binary.bzl", "java_binary")
load("//rule:merge_library.bzl", "kt_merge_library", "merge_library_jar")

kt_merge_library(
    name = "technetium_unmerged",
    srcs = glob([
        "src/main/kotlin/**/*.kt",
    ]),
    javac_opts = "//technetium:javac_opts_jvm_25",
    kotlinc_opts = "//technetium:kotlinc_opts_jvm_25",
    resource_strip_prefix = "technetium/versions/fabric/26.2/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    deps = [
        "//:compose",
        "//technetium/common",
        "//combine/backend/minecraft/game/26.2",
        "//combine/core/data",
        "//combine/core/layout",
        "//combine/core/modifier",
        "//combine/core/modifier/placement",
        "//combine/core/screen",
        "//combine/core/widget/layout",
        "//combine/theme/base",
        "//combine/theme/vanilla",
        "//combine/widget",
        "//game/26.2:game_client_libraries",
        "@maven_fabric_26_2//:net_fabricmc_fabric_api_fabric_api",
        "@maven_fabric_26_2//:net_fabricmc_fabric_api_fabric_lifecycle_events_v1",
        "@maven_fabric_26_2//:net_fabricmc_fabric_loader",
        "@maven_fabric_26_2//:net_fabricmc_sponge_mixin",
    ],
)

merge_library_jar(
    name = "technetium",
    visibility = ["//visibility:public"],
    deps = [
        ":technetium_unmerged",
        "//technetium/common",
    ],
)

alias(
    name = "26.2",
    actual = ":technetium",
    visibility = ["//visibility:public"],
)

# 本地启动客户端(可选,供有开发环境的机器使用)。
java_binary(
    name = "dev_client",
    srcs = [],
    data = [
        "//game/26.2:game_client_assets",
        "//game/26.2:game_client_assets_version",
    ],
    env = {
        "LANG": "en_US.UTF8",
    },
    jvm_flags = [
        "-Dfabric.development=true",
        "-Ddev.launch.version=26.2",
        "-Ddev.launch.type=client",
        "-Ddev.launch.assetsVersion=$(rlocationpath //game/26.2:game_client_assets_version)",
        "-Ddev.launch.mainClass=net.fabricmc.loader.impl.launch.knot.KnotClient",
        "-Xmx4G",
    ],
    main_class = "top.fifthlight.fabazel.devlaunchwrapper.DevLaunchWrapper",
    runtime_deps = [
        ":technetium_unmerged",
        "//combine/backend/minecraft/fabric:meta_jar",
        "//combine/backend/minecraft/versions/26.2",
        "//combine/backend/minecraft/versions/26.2:meta_jar",
        "//game/26.2:game_client",
        "//game/26.2:game_client_libraries",
        "//rule/dev_launch_wrapper",
        "@maven_fabric_26_2//:io_github_llamalad7_mixinextras_fabric",
        "@maven_fabric_26_2//:net_fabricmc_fabric_language_kotlin",
        "@maven_fabric_26_2//:net_fabricmc_fabric_loader",
        "@maven_fabric_26_2//:net_fabricmc_sponge_mixin",
    ],
)
