# Technetium — NeoForge 26.2 版本层。
# 结构参考:touchcontroller/versions/neoforge/26.2/BUILD.bazel。
# 这是「Fabric → NeoForge」过渡的第二个构建点(NeoForge 壳),复用 //technetium/common。

load("@rules_java//java:java_binary.bzl", "java_binary")
load("//rule:merge_library.bzl", "kt_merge_library", "merge_library_jar")
load("//rule/neoforge:mod_toml_jar.bzl", "neoforge_mod_toml_jar")

neoforge_mod_toml_jar(
    name = "neoforge_mod_toml",
    src = "src/main/resources/neoforge.mods.toml",
    substitutions = {},
)

kt_merge_library(
    name = "neoforge_unmerged",
    srcs = glob([
        "src/main/kotlin/**/*.kt",
    ]),
    javac_opts = "//technetium:javac_opts_jvm_25",
    kotlinc_opts = "//technetium:kotlinc_opts_jvm_25",
    # neoforge.mods.toml 必须通过 neoforge_mod_toml 打进 META-INF/,不能走普通 resources(会跑到根目录)。
    resource_strip_prefix = "technetium/versions/neoforge/26.2/src/main/resources",
    resources = glob(
        ["src/main/resources/**"],
        exclude = ["src/main/resources/neoforge.mods.toml"],
    ),
    resource_jars = [
        ":neoforge_mod_toml",
    ],
    deps = [
        "//:compose",
        "//technetium/common",

        # combine(仿基岩菜单)
        "//combine/core/data",
        "//combine/core/layout",
        "//combine/core/modifier",
        "//combine/core/modifier/placement",
        "//combine/core/screen",
        "//combine/core/widget/layout",
        "//combine/theme/base",
        "//combine/theme/vanilla",
        "//combine/widget",

        # Minecraft/NeoForge 客户端
        "//game/26.2:game_client_libraries",
        "//game/26.2:game_client_neoforge",

        # NeoForge + Mixin(neoforge maven repo 别名 @neoforge_26_2)
        # neoforge_deps 是合并的 NeoForge API 依赖(提供 net.neoforged.api.distmarker.Dist 等)
        "@neoforge_26_2//:neoforge_deps",
        "@neoforge_26_2//:net_fabricmc_sponge_mixin",
        "@neoforge_26_2//:net_neoforged_bus",
        "@neoforge_26_2//:net_neoforged_fancymodloader_loader",
    ],
)

merge_library_jar(
    name = "neoforge",
    visibility = ["//visibility:public"],
    deps = [
        ":neoforge_unmerged",
        "//technetium/common",
    ],
)

alias(
    name = "26.2",
    actual = "neoforge",
    visibility = ["//visibility:public"],
)

# 本地启动客户端(可选)。
java_binary(
    name = "dev_client",
    srcs = [],
    data = [
        "//game/26.2:game_client_assets",
        "//game/26.2:game_client_assets_version",
    ],
    env = {
        "LANG": "en_US.UTF8",
    },
    jvm_flags = [
        "-Ddev.launch.version=26.2",
        "-Ddev.launch.type=client",
        "-Ddev.launch.assetsVersion=$(rlocationpath //game/26.2:game_client_assets_version)",
        "-Ddev.launch.mainClass=net.neoforged.fml.startup.Client",
        "-Xmx4G",
    ],
    main_class = "top.fifthlight.fabazel.devlaunchwrapper.DevLaunchWrapper",
    runtime_deps = [
        ":neoforge_unmerged",
        "//combine/backend/minecraft/versions/26.2",
        "//combine/backend/minecraft/versions/26.2:meta_jar",
        "//game/26.2:game_client",
        "//game/26.2:game_client_libraries",
        "//rule/dev_launch_wrapper",
        "@neoforge_26_2//:net_fabricmc_sponge_mixin",
        "@neoforge_26_2//:net_neoforged_fancymodloader_loader",
    ],
)
